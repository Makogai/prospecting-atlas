# From the Discord Developer Portal -> your application -> Bot -> Reset Token.
# Treat this like a password; never commit the filled-in .env.
DISCORD_TOKEN=

# Developer Portal -> General Information -> Application ID.
DISCORD_CLIENT_ID=

# Optional. A test server id, so `npm run register:guild` registers instantly
# instead of waiting up to an hour for global commands to propagate.
DISCORD_GUILD_ID=

# Where the "Open on Atlas" buttons point. Leave unset and the buttons are
# omitted entirely, which is what you want before the site is deployed.
SITE_URL=
